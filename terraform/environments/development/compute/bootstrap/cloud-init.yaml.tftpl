#cloud-config
bootcmd:
  - [mkdir, -p, /var/lib/werant/bootstrap, /var/lib/rancher/k3s/server/manifests, "${local_storage_path}"]
  - [chmod, "0700", /var/lib/werant/bootstrap]

write_files:
  - path: /etc/rancher/k3s/config.yaml
    owner: root:root
    permissions: "0600"
    content: |
      write-kubeconfig-mode: "0600"
      node-name: "${node_name}"
      default-local-storage-path: "${local_storage_path}"
      secrets-encryption: true
      secrets-encryption-provider: "secretbox"
      node-label:
        - "werant.io/project=werant"
        - "werant.io/environment=development"
        - "werant.io/lifecycle=compute"
        - "werant.io/workload=k3s-node"
  - path: /var/lib/werant/bootstrap/flux-source.yaml
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${flux_source_manifest_base64}
  - path: /var/lib/werant/bootstrap/flux-kustomization.yaml
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${flux_kustomization_manifest_base64}

runcmd:
  - |
      set -eu
      curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
        --output /var/lib/werant/bootstrap/flux-install.yaml \
        'https://github.com/fluxcd/flux2/releases/download/${flux_version}/install.yaml'
      printf '%s  %s\n' \
        '${flux_manifest_sha256}' \
        '/var/lib/werant/bootstrap/flux-install.yaml' \
        | sha256sum --check --status
      install -m 0600 \
        /var/lib/werant/bootstrap/flux-install.yaml \
        /var/lib/rancher/k3s/server/manifests/flux-system.yaml
      curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
        --output /var/lib/werant/bootstrap/install-k3s.sh \
        https://get.k3s.io
      chmod 0700 /var/lib/werant/bootstrap/install-k3s.sh
      INSTALL_K3S_VERSION='${k3s_version}' \
        /var/lib/werant/bootstrap/install-k3s.sh server
  - |
      timeout 300 sh -c 'until /usr/local/bin/k3s kubectl get --raw=/readyz >/dev/null 2>&1; do sleep 5; done'
  - [touch, /var/lib/werant/bootstrap/k3s-ready]
  - |
      timeout 600 sh -c 'until /usr/local/bin/k3s kubectl --namespace flux-system wait --for=condition=Available --timeout=10s deployment/source-controller deployment/kustomize-controller deployment/helm-controller deployment/notification-controller >/dev/null 2>&1; do sleep 5; done'
  - [/usr/local/bin/k3s, kubectl, apply, --filename, /var/lib/werant/bootstrap/flux-source.yaml]
  - [/usr/local/bin/k3s, kubectl, apply, --filename, /var/lib/werant/bootstrap/flux-kustomization.yaml]
  - [touch, /var/lib/werant/bootstrap/flux-ready]

final_message: "Werant Development K3s and Flux controller bootstrap completed"
